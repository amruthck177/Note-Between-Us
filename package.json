{
  "name": "inuguration-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "node --watch --env-file-if-exists=.env server/index.js",
    "client:dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "vite build --configLoader runner",
    "start": "node --env-file-if-exists=.env server/index.js",
    "start:local": "npm run build && node --env-file-if-exists=.env server/start-local.js",
    "test": "node --test"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vitejs/plugin-react": "^4.4.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "googleapis": "^156.0.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.0"
  }
}
